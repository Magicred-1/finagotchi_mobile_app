  "states": {
    "default": "daily companion, matches colors.primary #35D7FF",
    "evolution": "evolution / spectral moments, matches colors.purple #9945FF",
    "calm": "resting base form, neutral toy-like",
    "reward": "points, streaks, currency, matches colors.warning #FFD166",
    "danger": "sick / neglect warning, matches colors.danger #FF647C",
    "healthy": "post-check-in positive state"
  },
  "firmware": {
    "note": "Each variant is a flat 2-color sprite on a solid background: quantize to body + face + background palette entries. Corner-emergence crops are presentation-only; extract the centered silhouette for the device display."
  }
