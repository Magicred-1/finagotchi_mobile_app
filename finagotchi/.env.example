EXPO_PUBLIC_API_URL=https://api.finagotchi.app
EXPO_PUBLIC_SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Used by the DCA clients (on-chain plan creation, fill watching).
EXPO_PUBLIC_JUPITER_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
EXPO_PUBLIC_HELIUS_API_KEY=
EXPO_PUBLIC_ARWEAVE_GATEWAY=https://arweave.net
# Dynamic.xyz environment ID — create a project and copy it from
# https://app.dynamic.xyz/dashboard/developer/api
# In the dashboard also: whitelist https://www.finagotchi.app as an allowed
# origin, add finagotchi:// as a deeplink/redirect URL, and enable the Solana
# chain, embedded wallets, and Email/Google/Apple/Passkey sign-in methods.
EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Email of the Dynamic Test Account used for App Store review (Live
# environments only — Sandbox matches any "+dynamic_test" email automatically).
# Registered under Dynamic dashboard → Developer → Test Accounts.
# Comma-separated if several. Demo accounts mint/revive without SOL.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_MINT_TREASURY_ADDRESS=
EXPO_PUBLIC_JUPITER_API_KEY=
# Pyth Network API key for the Hermes price feed (sidebar token balances).
# OPTIONAL: Hermes has required a key since the Pyth Core upgrade (Aug 2026),
# but without one the app automatically falls back to Jupiter's keyless lite
# price API. Set this only if you want Pyth as the price source
# (https://www.pyth.network/developers, free tier).
EXPO_PUBLIC_PYTH_API_KEY=